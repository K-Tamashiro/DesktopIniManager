        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="13" VerticalAlignment="Center"/>
              <TextBlock Text="Search" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </TabItem.Header>
        </TabItem>
      </TabControl></Grid></Border>
    </Grid>
    <StackPanel Grid.Row="2" Margin="0,10,0,0"><ProgressBar x:Name="SearchProgress" Height="6" Margin="0,0,0,6" IsIndeterminate="True" Visibility="Collapsed" Foreground="{DynamicResource Accent}" Background="{DynamicResource HeaderBackground}"><ProgressBar.Template><ControlTemplate TargetType="{x:Type ProgressBar}"><Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True"><Border x:Name="Marquee" Width="150" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform></Border></Border></ControlTemplate></ProgressBar.Template></ProgressBar><DockPanel LastChildFill="False"><TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="RemoveButton" Style="{StaticResource IconTextButton}" Background="{DynamicResource Secondary}" Click="Remove_Click" ToolTip="Remove settings">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="15" VerticalAlignment="Center"/><TextBlock Text=" Icon Remove" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <Button Content="MFT Differencer" Click="MftDifferencer_Click" Margin="8,0,0,0" Padding="10,7"/>
          <Button x:Name="GrepButton" Style="{StaticResource IconTextButton}" Margin="8,0,0,0" Click="Grep_Click" ToolTip="Grep selected folders">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="15" VerticalAlignment="Center"/><TextBlock Text=" Scoped Code Grep" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <Button x:Name="ApplyButton" Style="{StaticResource IconTextButton}" Margin="8,0,0,0" Click="Apply_Click" ToolTip="Apply to selected folders">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="15" VerticalAlignment="Center"/><TextBlock Text=" Icon Apply" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
          </Button></StackPanel></DockPanel></StackPanel>
  </Grid>
</Window>
