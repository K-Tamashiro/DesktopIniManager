    <DataTemplate x:Key="FileIconLargeTemplate"><StackPanel Margin="4,6" HorizontalAlignment="Stretch"><Border Width="72" Height="72" HorizontalAlignment="Center" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="6"><Image Source="{Binding Icon}" Width="48" Height="48" Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant"/></Border><TextBlock Text="{Binding Name}" Margin="2,6,2,0" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Path}"/></StackPanel></DataTemplate>
    <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
