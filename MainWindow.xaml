      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSearchMatch}" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeSelected}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></DataTrigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HeaderBackground}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeSelected}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
