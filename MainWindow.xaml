    </ControlTemplate>
    <Style TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="8"/><Setter Property="Height" Value="8"/><Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Vertical"><Setter Property="Width" Value="8"/><Setter Property="Height" Value="Auto"/><Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/></Trigger>
        <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="8"/><Setter Property="Width" Value="Auto"/><Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/></Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><StackPanel><TextBlock Text="desktop.ini Manager" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/><TextBlock Text="Find folders by name or content and apply custom icons in batches" Foreground="{DynamicResource Muted}" Margin="2,4,0,22"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" Padding="10,7" Margin="0,0,12,0"><CheckBox x:Name="FastNtfsSearchBox" IsChecked="False" VerticalContentAlignment="Center"><StackPanel Margin="5,-1,0,0"><TextBlock Text="Use fast NTFS search" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/><TextBlock Text="Windows may ask for permission" Margin="0,2,0,0" Foreground="{DynamicResource Muted}" FontSize="10"/></StackPanel></CheckBox></Border><Border Background="{DynamicResource ThemeToggle}" CornerRadius="8" Padding="2" Margin="0,0,12,0"><StackPanel Orientation="Horizontal"><ToggleButton x:Name="LightThemeButton" Style="{StaticResource ThemeToggleStyle}" Content="☀" Foreground="{DynamicResource SunGlyph}" ToolTip="Light mode" Click="LightTheme_Click"/><ToggleButton x:Name="DarkThemeButton" Style="{StaticResource ThemeToggleStyle}" Content="☾" Foreground="{DynamicResource MoonGlyph}" ToolTip="Dark mode" Click="DarkTheme_Click"/></StackPanel></Border><Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Background="{DynamicResource Secondary}" ToolTip="Close" Click="Close_Click"/></StackPanel></Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,6,0">
        <TextBlock Text="Search" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
        <TextBlock Text="Search location" Margin="0,16,0,6" Foreground="{DynamicResource Muted}"/><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8B7;" Click="ChooseRoot_Click" Margin="8,0,0,0" ToolTip="Browse"/><TextBox x:Name="RootBox" HorizontalContentAlignment="Left" TextAlignment="Left" TextWrapping="NoWrap"/></DockPanel>
        <TextBlock Text="Cloud and network locations are not supported." Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
        <TextBlock Text="Keywords (optional)" Margin="0,14,0,6" Foreground="{DynamicResource Muted}"/><TextBox x:Name="QueryBox" Text=""/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button x:Name="GitSearchButton" Style="{StaticResource IconTextButton}" Click="GitSearch_Click" ToolTip="GIT Search">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE943;" FontSize="15" VerticalAlignment="Center"/><TextBlock Text=" GIT" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <Button x:Name="SearchButton" Style="{StaticResource IconTextButton}" Click="Search_Click" Margin="8,0,0,0" ToolTip="Search">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="15" VerticalAlignment="Center"/><TextBlock Text=" Search" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <Button x:Name="CancelButton" Style="{StaticResource IconButton}" Content="&#xE711;" Click="Cancel_Click" Background="{DynamicResource Secondary}" Margin="8,0,0,0" IsEnabled="False" ToolTip="Cancel"/>
        </StackPanel>
        <Separator Margin="0,22"/>
        <TextBlock Text="Replacement icon" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
        <TextBlock Text="ICO / ICL / DLL / EXE" Margin="0,14,0,6" Foreground="{DynamicResource Muted}"/><TextBox x:Name="IconPathBox" HorizontalContentAlignment="Left" TextAlignment="Left" TextWrapping="NoWrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
