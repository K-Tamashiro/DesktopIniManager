<Window x:Class="DesktopIniManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="desktop.ini Manager" Icon="DesktopIniManager.ico" Width="1120" Height="820" MinWidth="900" MinHeight="620" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Ink}" WindowStartupLocation="CenterScreen">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><StackPanel><TextBlock Text="desktop.ini Manager" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/><TextBlock Text="Find folders by name or content and apply custom icons in batches" Foreground="{DynamicResource Muted}" Margin="2,4,0,22"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" Padding="10,7" Margin="0,0,12,0"><CheckBox x:Name="FastNtfsSearchBox" IsChecked="False" VerticalContentAlignment="Center"><StackPanel Margin="5,-1,0,0"><TextBlock Text="Use fast NTFS search" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/><TextBlock Text="Windows may ask for permission" Margin="0,2,0,0" Foreground="{DynamicResource Muted}" FontSize="10"/></StackPanel></CheckBox></Border><Border Background="{DynamicResource ThemeToggle}" CornerRadius="8" Padding="2" Margin="0,0,12,0"><StackPanel Orientation="Horizontal"><ToggleButton x:Name="LightThemeButton" Style="{StaticResource ThemeToggleStyle}" Content="☀" Foreground="{DynamicResource SunGlyph}" ToolTip="Light mode" Click="LightTheme_Click"/><ToggleButton x:Name="DarkThemeButton" Style="{StaticResource ThemeToggleStyle}" Content="☾" Foreground="{DynamicResource MoonGlyph}" ToolTip="Dark mode" Click="DarkTheme_Click"/></StackPanel></Border><Button Content="Close" Width="90" Background="{DynamicResource Secondary}" Click="Close_Click"/></StackPanel></Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,6,0">
        <TextBlock Text="Search" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
        <TextBlock Text="Search location" Margin="0,16,0,6" Foreground="{DynamicResource Muted}"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse" Click="ChooseRoot_Click" Margin="8,0,0,0"/><TextBox x:Name="RootBox"/></DockPanel>
        <TextBlock Text="Keywords (optional)" Margin="0,14,0,6" Foreground="{DynamicResource Muted}"/><TextBox x:Name="QueryBox" Text=""/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="GitSearchButton" Content="GIT Search" Click="GitSearch_Click"/><Button x:Name="SearchButton" Content="Search" Click="Search_Click" Margin="8,0,0,0"/><Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Background="{DynamicResource Secondary}" Margin="8,0,0,0" IsEnabled="False"/></StackPanel>
        <Separator Margin="0,22"/>
        <TextBlock Text="Replacement icon" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
        <TextBlock Text="ICO / ICL / DLL / EXE" Margin="0,14,0,6" Foreground="{DynamicResource Muted}"/><TextBox x:Name="IconPathBox"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Change library" Click="ChooseIconLibrary_Click"/><Button Content="Choose icon" Click="ChooseIcon_Click" Margin="8,0,0,0"/></StackPanel>
        <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,12,0,0" Padding="10" Height="116"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image x:Name="SelectedIconImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="Selected icon" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="SelectedIconText" Text="Not selected" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,5,0,0"/></StackPanel></Grid></Border>
      </StackPanel></ScrollViewer></Border>
      <Border Grid.Column="2" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource CardBackground}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource HeaderBackground}" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="SelectAllBox" Content="Select all" IsChecked="True" Click="SelectAll_Click"/><Button Grid.Column="1" Content="Physical" Padding="9,4" Margin="10,0,0,0" Click="PhysicalView_Click"/><Button Grid.Column="2" Content="Solution" Padding="9,4" Margin="5,0,0,0" Click="SolutionView_Click"/><Button Grid.Column="3" Content="Expand" Padding="9,4" Margin="10,0,0,0" Click="ExpandAll_Click"/><Button Grid.Column="4" Content="Collapse" Padding="9,4" Margin="5,0,0,0" Background="{DynamicResource Secondary}" Click="CollapseAll_Click"/><CheckBox Grid.Column="6" x:Name="AddToGitIgnoreBox" Content="Add desktop.ini to .gitignore" IsChecked="False"/><TextBlock Grid.Column="7" x:Name="CountText" Text="0 matches" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/></Grid></Border>
        <TreeView Grid.Row="1" x:Name="ResultsTree" BorderThickness="0" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource Ink}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Children}"><Grid Margin="0" Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"><Grid.ContextMenu><ContextMenu><MenuItem Header="Use as search location" Click="UseAsSearchLocation_Click" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/></ContextMenu></Grid.ContextMenu><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected}" Margin="5" VerticalAlignment="Center"/><Image Grid.Column="1" Source="{Binding IconPreview}" Width="48" Height="48" Margin="5,3" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel Grid.Column="2" Margin="0,5,5,5" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Ink}"/><TextBlock Text="{Binding Path}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Reason}" Foreground="{DynamicResource Accent}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}"/></StackPanel></Grid></HierarchicalDataTemplate></TreeView.ItemTemplate>
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
                <Grid Background="Transparent"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <ToggleButton x:Name="Expander" Grid.Column="0" Content="▶" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Foreground="{DynamicResource Muted}"><ToggleButton.Style><Style TargetType="ToggleButton"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/></ControlTemplate></Setter.Value></Setter></Style></ToggleButton.Style></ToggleButton>
                  <Border Grid.Column="1" Background="{TemplateBinding Background}" HorizontalAlignment="Stretch"><ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch"/></Border>
                  <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Expander" Property="Content" Value="▼"/></Trigger><Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers>
              </ControlTemplate></Setter.Value></Setter>
              <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeSelected}"/></Trigger></Style.Triggers>
            </Style>
          </TreeView.ItemContainerStyle>
        </TreeView>
      </Grid></Border>
    </Grid>
    <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel LastChildFill="False"><TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="RemoveButton" Width="120" Content="Remove settings" Background="{DynamicResource Secondary}" Click="Remove_Click"/><Button x:Name="ApplyButton" Width="210" Margin="8,0,0,0" Content="Apply to selected folders" Click="Apply_Click"/></StackPanel></DockPanel><ProgressBar x:Name="SearchProgress" Grid.Row="1" Height="5" Margin="0,8,0,0" IsIndeterminate="True" Visibility="Collapsed" Foreground="{DynamicResource Accent}" Background="{DynamicResource HeaderBackground}"/></Grid>
  </Grid>
</Window>
