 Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" RenderOptions.EdgeMode="Aliased"/></Border><TextBlock Text="{Binding Name}" Margin="1,4,1,0" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Path}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
