<Window
  x:Class="DesktopIniManager.Views.CleanReportWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Width="900" Height="570" MinWidth="680" MinHeight="360"
  x:ClassModifier="internal"
  Background="{DynamicResource WindowBackground}"
  Foreground="{DynamicResource Ink}"
  WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="SummaryText" Grid.Row="0" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
    <TextBlock x:Name="LogPathText" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,12" Opacity="0.75" />
    <TextBox x:Name="LogBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"
             FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap"
             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
    <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,14,0,0">
      <Button ToolTip="閉じる" IsDefault="True" Width="44" Height="44"
              DockPanel.Dock="Right" Click="Close_Click" Padding="0"
              Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
              FocusVisualStyle="{x:Null}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </ControlTemplate>
        </Button.Template>
        <Image x:Name="CloseButtonIcon" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality" />
      </Button>
    </DockPanel>
  </Grid>
</Window>
