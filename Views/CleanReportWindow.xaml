<Window
  x:Class="DesktopIniManager.Views.CleanReportWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Width="900"
  Height="570"
  MinWidth="680"
  MinHeight="360"
  x:ClassModifier="internal"
  Background="{DynamicResource WindowBackground}"
  Foreground="{DynamicResource Ink}"
  WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock
      x:Name="SummaryText"
      Grid.Row="0"
      Margin="0,0,0,8"
      FontSize="18"
      FontWeight="SemiBold" />
    <TextBlock
      x:Name="LogPathText"
      Grid.Row="1"
      Margin="0,0,0,12"
      Opacity="0.75"
      TextWrapping="Wrap" />
    <TextBox
      x:Name="LogBox"
      Grid.Row="2"
      AcceptsReturn="True"
      FontFamily="Consolas"
      FontSize="13"
      HorizontalScrollBarVisibility="Auto"
      IsReadOnly="True"
      TextWrapping="NoWrap"
      VerticalScrollBarVisibility="Auto" />
    <DockPanel
      Grid.Row="3"
      Margin="0,14,0,0"
      LastChildFill="False">
      <Button
        Width="44"
        Height="44"
        Padding="0"
        Background="Transparent"
        BorderBrush="Transparent"
        BorderThickness="0"
        Click="Close_Click"
        DockPanel.Dock="Right"
        FocusVisualStyle="{x:Null}"
        IsDefault="True"
        ToolTip="閉じる">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </ControlTemplate>
        </Button.Template>
        <Image
          x:Name="CloseButtonIcon"
          RenderOptions.BitmapScalingMode="HighQuality"
          Stretch="Uniform" />
      </Button>
    </DockPanel>
  </Grid>
</Window>
