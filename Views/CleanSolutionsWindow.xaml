<Window
  x:Class="DesktopIniManager.Views.CleanSolutionsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:history="clr-namespace:DesktopIniManager.Views"
  xmlns:loc="clr-namespace:DesktopIniManager.Properties"
  Title="{loc:L Differencer_CleanSolutionsTitle}"
  Width="760"
  Height="480"
  x:ClassModifier="internal"
  Background="{DynamicResource WindowBackground}"
  Foreground="{DynamicResource Ink}"
  WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <SolidColorBrush x:Key="SourceColor" Color="#E8B949" />
    <SolidColorBrush x:Key="TargetColor" Color="#2878BF" />
  </Window.Resources>
  <DockPanel Margin="16">
    <TextBlock
      Margin="0,0,0,12"
      DockPanel.Dock="Top"
      Text="{loc:L Differencer_CleanDialogHint}"
      TextWrapping="Wrap" />
    <StackPanel Margin="0,12,0,0" DockPanel.Dock="Bottom">
      <TextBlock Text="{loc:L Differencer_ConfigurationsLabel}" />
      <history:HistoryTextBox
        x:Name="ConfigurationBox"
        Margin="0,6,0,12"
        HistoryKey="Differencer-CleanConfigurations"
        Text="Debug;Release" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button
          x:Name="CancelButton"
          Margin="0,0,8,0"
          Background="Transparent"
          Click="Cancel_Click"
          IsCancel="True"
          Style="{StaticResource IconButton}"
          ToolTip="{loc:L Common_Cancel}">
          <Image
            x:Name="CancelButtonIcon"
            RenderOptions.BitmapScalingMode="HighQuality"
            Stretch="Uniform" />
        </Button>
        <Button
          x:Name="RunButton"
          Background="Transparent"
          Click="Run_Click"
          IsDefault="True"
          Style="{StaticResource IconButton}"
          ToolTip="{loc:L Common_Clean}">
          <Image
            x:Name="RunButtonIcon"
            RenderOptions.BitmapScalingMode="HighQuality"
            Stretch="Uniform" />
        </Button>
      </StackPanel>
    </StackPanel>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="SolutionList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border
              Margin="0,0,0,8"
              Padding="10,6,10,2"
              Background="{DynamicResource CardBackground}"
              BorderThickness="4,1,1,1"
              CornerRadius="4">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="BorderBrush" Value="{DynamicResource TargetColor}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSource}" Value="True">
                      <Setter Property="BorderBrush" Value="{DynamicResource SourceColor}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="{Binding SideLabel}" />
                <CheckBox
                  Margin="0,6"
                  Content="{Binding Path}"
                  IsChecked="{Binding IsChecked}"
                  IsEnabled="{Binding IsEnabled}"
                  ToolTip="{Binding Tip}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
