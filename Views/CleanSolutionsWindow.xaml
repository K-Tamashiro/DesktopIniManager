<Window
  x:Class="DesktopIniManager.Views.CleanSolutionsWindow"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:history="clr-namespace:DesktopIniManager.Views"
  xmlns:loc="clr-namespace:DesktopIniManager.Properties"
  Title="{loc:L Differencer_CleanSolutionsTitle}"
  Width="760"
  Height="480"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource WindowBackground}"
  Foreground="{DynamicResource Ink}">
  <Window.Resources>
    <SolidColorBrush x:Key="SourceColor" Color="#E8B949" />
    <SolidColorBrush x:Key="TargetColor" Color="#2878BF" />
    <SolidColorBrush x:Key="CleanColor" Color="#28784B" />
    <Style x:Key="DifferencerActionButton" BasedOn="{StaticResource IconTextButton}" TargetType="Button">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Frame">
              <Border Background="{TemplateBinding Background}" CornerRadius="10" />
              <Border x:Name="Highlight" Background="White" CornerRadius="10" Opacity="0" />
              <Border Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Highlight" Property="Opacity" Value="0.12" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Highlight" Property="Opacity" Value="0.22" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Frame" Property="Opacity" Value="0.48" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <DockPanel Margin="16">
    <TextBlock
      Margin="0,0,0,12"
      DockPanel.Dock="Top"
      Text="{loc:L Differencer_CleanDialogHint}"
      TextWrapping="Wrap" />
    <StackPanel Margin="0,12,0,0" DockPanel.Dock="Bottom">
      <TextBlock Text="{loc:L Differencer_ConfigurationsLabel}" />
      <history:HistoryTextBox
        x:Name="ConfigurationBox"
        Margin="0,6,0,12"
        HistoryKey="Differencer-CleanConfigurations"
        Text="Debug;Release" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button
          x:Name="CancelButton"
          Margin="0,0,8,0"
          Background="{DynamicResource Secondary}"
          Click="Cancel_Click"
          IsCancel="True"
          Style="{DynamicResource DifferencerActionButton}" />
        <Button
          x:Name="RunButton"
          Background="{DynamicResource CleanColor}"
          Click="Run_Click"
          IsDefault="True"
          Style="{DynamicResource DifferencerActionButton}" />
      </StackPanel>
    </StackPanel>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="SolutionList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border
              Margin="0,0,0,8"
              Padding="10,6,10,2"
              Background="{DynamicResource CardBackground}"
              BorderThickness="4,1,1,1"
              CornerRadius="4">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="BorderBrush" Value="{DynamicResource TargetColor}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSource}" Value="True">
                      <Setter Property="BorderBrush" Value="{DynamicResource SourceColor}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="{Binding SideLabel}" />
                <CheckBox
                  Margin="0,6"
                  Content="{Binding Path}"
                  IsChecked="{Binding IsChecked}"
                  IsEnabled="{Binding IsEnabled}"
                  ToolTip="{Binding Tip}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
