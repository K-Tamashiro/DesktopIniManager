<Window
  x:Class="DesktopIniManager.Views.DeveloperDifferencerWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:history="clr-namespace:DesktopIniManager.Views"
  xmlns:loc="clr-namespace:DesktopIniManager.Properties"
  Title="{loc:L Differencer_Title}"
  Width="1280"
  Height="800"
  MinWidth="960"
  MinHeight="540"
  Background="{DynamicResource WindowBackground}"
  Foreground="{DynamicResource Ink}"
  WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="MvvmBooleanToVisibility"/>
    <SolidColorBrush x:Key="SourceColor" Color="#E8B949" />
    <SolidColorBrush x:Key="TargetColor" Color="#2878BF" />
    <SolidColorBrush x:Key="CleanColor" Color="#28784B" />
    <Style
      x:Key="DifferencerActionButton"
      BasedOn="{StaticResource IconTextButton}"
      TargetType="Button">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Frame">
              <Border Background="{TemplateBinding Background}" CornerRadius="10" />
              <Border
                x:Name="Highlight"
                Background="White"
                CornerRadius="10"
                Opacity="0" />
              <Border Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Highlight" Property="Opacity" Value="0.12" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Highlight" Property="Opacity" Value="0.22" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Frame" Property="Opacity" Value="0.48" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FilterActionButtonStyle" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Frame"
              Padding="5,4"
              Background="{DynamicResource Secondary}"
              CornerRadius="8"
              SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource AccentSoft}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="Frame" Property="BorderThickness" Value="1" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="KindFilterStyle" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border
              x:Name="Frame"
              Padding="5,4"
              Background="{DynamicResource Secondary}"
              CornerRadius="8"
              SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource AccentSoft}" />
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="Frame" Property="BorderThickness" Value="1" />
              </Trigger>
              <Trigger Property="IsChecked" Value="False">
                <Setter Property="Opacity" Value="0.55" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FileListItemStyle" TargetType="ListViewItem">
      <Setter Property="Height" Value="80" />
      <EventSetter Event="Loaded" Handler="FileRowLoaded" />
      <EventSetter Event="Unloaded" Handler="FileRowUnloaded" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border
              x:Name="RowBorder"
              Padding="2,1"
              Background="{TemplateBinding Background}"
              BorderBrush="Transparent"
              BorderThickness="2,0,0,0"
              TextElement.Foreground="{TemplateBinding Foreground}">
              <GridViewRowPresenter Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}" Content="{TemplateBinding Content}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource AccentSoft}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource ThemeSelected}" />
                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Background" Value="{DynamicResource HeaderBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridViewColumnHeader">
            <Border
              x:Name="HeaderBorder"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource AccentSoft}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FolderItemStyle" TargetType="TreeViewItem">
      <Setter Property="IsExpanded" Value="{Binding Expanded, Mode=TwoWay}" />
      <Setter Property="IsSelected" Value="{Binding Active, Mode=TwoWay}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <Grid Background="Transparent">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <ToggleButton
                x:Name="Expander"
                Content="▶"
                Focusable="False"
                Foreground="{DynamicResource Muted}"
                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <TextBlock
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Foreground="{TemplateBinding Foreground}"
                      Text="{TemplateBinding Content}" />
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Border Grid.Column="1" Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Stretch" ContentSource="Header" />
              </Border>
              <ItemsPresenter
                x:Name="ItemsHost"
                Grid.Row="1"
                Grid.Column="1" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="HasItems" Value="False">
                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
              </Trigger>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="Expander" Property="Content" Value="▼" />
              </Trigger>
              <Trigger Property="IsExpanded" Value="False">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource ThemeSelected}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="SideTemplate">
      <DockPanel
        Margin="6"
        VerticalAlignment="Center"
        LastChildFill="True"
        ToolTip="{Binding Info}">
        <Image
          Width="56"
          Height="48"
          Margin="0,0,6,0"
          HorizontalAlignment="Left"
          DockPanel.Dock="Left"
          Source="{Binding Thumbnail}"
          Stretch="Uniform">
          <Image.Style>
            <Style TargetType="Image">
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasImage}" Value="False">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Image.Style>
        </Image>
        <StackPanel VerticalAlignment="Center">
          <TextBlock FontSize="11" Text="{Binding SummaryInfo}" />
          <TextBlock
            FontSize="10"
            Text="{Binding Dimensions}"
            TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DockPanel>
    </DataTemplate>
  </Window.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
          VerticalAlignment="Center"
          FontSize="26"
          FontWeight="SemiBold"
          Foreground="{DynamicResource Accent}"
          Text="{loc:L Differencer_Title}" />
        <Button
          x:Name="CloseButton"
          Grid.Column="2"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Click="CloseClick"
          Content="&#xE711;"
          Style="{StaticResource IconButton}"
          ToolTip="{loc:L Common_Close}" />
      </Grid>
      <Grid x:Name="RootControls" IsEnabled="{Binding CanEdit}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock
          Margin="0,0,12,6"
          VerticalAlignment="Center"
          Text="{loc:L Common_Source}" />
        <history:HistoryTextBox
          x:Name="SourceBox" Text="{Binding SourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          Grid.Column="1"
          Margin="0,0,8,6"
          BorderBrush="{StaticResource SourceColor}"
          BorderThickness="4,1,1,1"
          HistoryKey="Differencer-Source" />
        <Button
          Grid.Column="2"
          Margin="0,0,0,6"
          Click="BrowseSource"
          Content="&#xE8B7;"
          Style="{StaticResource IconButton}"
          ToolTip="{loc:L Common_Browse}" />
        <TextBlock
          Grid.Row="1"
          VerticalAlignment="Center"
          Text="{loc:L Common_Target}" />
        <history:HistoryTextBox
          x:Name="TargetBox" Text="{Binding TargetPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          Grid.Row="1"
          Grid.Column="1"
          Margin="0,0,8,0"
          BorderBrush="{StaticResource TargetColor}"
          BorderThickness="4,1,1,1"
          HistoryKey="Differencer-Target" />
        <Button
          Grid.Row="1"
          Grid.Column="2"
          Click="BrowseTarget"
          Content="&#xE8B7;"
          Style="{StaticResource IconButton}"
          ToolTip="{loc:L Common_Browse}" />
      </Grid>
      <Grid Margin="0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button
            x:Name="CompareButton"
            Command="{Binding CompareCommand}"
            Style="{StaticResource DifferencerActionButton}">
            <StackPanel Orientation="Horizontal">
              <TextBlock
                VerticalAlignment="Center"
                FontFamily="Segoe MDL2 Assets"
                FontSize="15"
                Text="&#xE721;" />
              <TextBlock
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                Text="{loc:L Common_Compare}" />
            </StackPanel>
          </Button>
          <Button
            x:Name="CancelCompareButton"
            Margin="8,0,0,0"
            Background="{DynamicResource Secondary}"
            Command="{Binding CancelCommand}"
            Content="&#xE711;"
            IsEnabled="{Binding CanCancel}"
            Style="{StaticResource IconButton}"
            ToolTip="{loc:L Differencer_CancelCompare}" />
          <CheckBox
            x:Name="CompareTimestampBox" IsEnabled="{Binding CanEdit}"
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            Content="{loc:L Differencer_CompareDates}"
            IsChecked="{Binding CompareTimestamp}"
            ToolTip="{loc:L Differencer_CompareDatesTip}" />
          <Button
            x:Name="CleanSolutionButton"
            Margin="12,0,0,0"
            Background="{StaticResource CleanColor}"
            Command="{Binding CleanCommand}"
            Style="{StaticResource DifferencerActionButton}"
            ToolTip="{loc:L Differencer_CleanTip}">
            <StackPanel Orientation="Horizontal">
              <TextBlock
                VerticalAlignment="Center"
                FontFamily="Segoe MDL2 Assets"
                FontSize="15"
                Text="&#xE75C;" />
              <TextBlock
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                Text="{loc:L Differencer_CleanSolution}" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel
          Grid.Column="2"
          HorizontalAlignment="Right"
          Orientation="Horizontal">
          <TextBlock
            x:Name="CountText" Text="{Binding CountLabel}"
            Margin="16,0,0,0"
            VerticalAlignment="Center" />
          <Button
            x:Name="ForwardButton"
            Margin="12,0,0,0"
            Background="{StaticResource SourceColor}"
            Command="{Binding ForwardCommand}"
            Foreground="#20252B"

            Style="{StaticResource DifferencerActionButton}">
            <StackPanel Orientation="Horizontal">
              <TextBlock
                VerticalAlignment="Center"
                FontFamily="Segoe MDL2 Assets"
                FontSize="15"
                Text="&#xE74B;" />
              <TextBlock
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                Text="{loc:L Differencer_SourceToTarget}" />
            </StackPanel>
          </Button>
          <Button
            x:Name="ReverseButton"
            Margin="8,0,0,0"
            Background="{StaticResource TargetColor}"
            Command="{Binding ReverseCommand}"

            Style="{StaticResource DifferencerActionButton}">
            <StackPanel Orientation="Horizontal">
              <TextBlock
                VerticalAlignment="Center"
                FontFamily="Segoe MDL2 Assets"
                FontSize="15"
                Text="&#xE74A;" />
              <TextBlock
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                Text="{loc:L Differencer_TargetToSource}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </StackPanel>
    <StackPanel Margin="0,10,0,0" DockPanel.Dock="Bottom">
      <ProgressBar
        x:Name="CompareProgress" Value="{Binding ProgressValue}" Maximum="{Binding ProgressMaximum}" IsIndeterminate="{Binding ProgressIndeterminate}"
        Height="6"
        Margin="0,0,0,6"
        Background="{DynamicResource HeaderBackground}"
        Foreground="{DynamicResource Accent}"
        Visibility="{Binding IsProgressVisible, Converter={StaticResource MvvmBooleanToVisibility}}" />
      <TextBlock
        x:Name="StatusText"
        Text="{Binding Status}"
        TextWrapping="Wrap" />
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" MinWidth="220" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition MinWidth="400" />
      </Grid.ColumnDefinitions>
      <Border
        Background="{DynamicResource CardBackground}"
        BorderBrush="{DynamicResource Line}"
        BorderThickness="1">
        <DockPanel>
          <Border
            Padding="10,7"
            Background="{DynamicResource HeaderBackground}"
            DockPanel.Dock="Top">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button
                  Command="{Binding ExpandAllCommand}"
                  Content="&#xE70D;"
                  Style="{StaticResource IconButton}"
                  ToolTip="{loc:L Common_Expand}" />
                <Button
                  Margin="5,0,0,0"
                  Background="{DynamicResource Secondary}"
                  Command="{Binding CollapseAllCommand}"
                  Content="&#xE70E;"
                  Style="{StaticResource IconButton}"
                  ToolTip="{loc:L Common_Collapse}" />
                <Button
                  Margin="10,0,0,0"
                  Background="{DynamicResource Secondary}"
                  Click="CompactTree_Click"
                  Content="a"
                  FontSize="13"
                  Style="{StaticResource TypeSizeButton}"
                  ToolTip="{loc:L Main_TreeCompact}" />
                <Button
                  Margin="5,0,0,0"
                  Background="{DynamicResource Secondary}"
                  Click="ComfortableTree_Click"
                  Content="A"
                  FontSize="17"
                  Style="{StaticResource TypeSizeButton}"
                  ToolTip="{loc:L Main_TreeComfortable}" />
              </StackPanel>
              <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{loc:L Common_Folders}" />
            </DockPanel>
          </Border>
          <Border
            Padding="8,5"
            BorderBrush="{DynamicResource Line}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <WrapPanel x:Name="CategoryFilters" IsEnabled="{Binding CanFilter}">
              <Button
                x:Name="RefreshCompareButton"
                AutomationProperties.Name="Refresh selected folder"
                Command="{Binding RefreshCommand}"
                Style="{StaticResource FilterActionButtonStyle}"
                ToolTip="Refresh selected folder">
                <Image
                  x:Name="RefreshCompareIcon"
                  Width="22"
                  Height="22"
                  RenderOptions.BitmapScalingMode="HighQuality"
                  Stretch="Uniform" />
              </Button>
              <CheckBox
                x:Name="SameFilter"
                Command="{Binding CategoryFilterCommand}"
                IsChecked="{Binding ShowSame}"
                Style="{StaticResource KindFilterStyle}"
                ToolTip="{loc:L Differencer_SameTimeSize}">
                <Image
                  x:Name="SameFilterIcon"
                  Width="22"
                  Height="22"
                  RenderOptions.BitmapScalingMode="HighQuality"
                  Stretch="Uniform" />
              </CheckBox>
              <CheckBox
                x:Name="DifferentFilter"
                Command="{Binding CategoryFilterCommand}"
                IsChecked="{Binding ShowDifferent}"
                Style="{StaticResource KindFilterStyle}"
                ToolTip="{loc:L Differencer_DifferentMeta}">
                <Image
                  x:Name="DifferentFilterIcon"
                  Width="22"
                  Height="22"
                  RenderOptions.BitmapScalingMode="HighQuality"
                  Stretch="Uniform" />
              </CheckBox>
              <CheckBox
                x:Name="SourceOnlyFilter"
                Command="{Binding CategoryFilterCommand}"
                IsChecked="{Binding ShowSourceOnly}"
                Style="{StaticResource KindFilterStyle}"
                ToolTip="{loc:L Differencer_SourceOnly}">
                <Image
                  x:Name="SourceOnlyFilterIcon"
                  Width="22"
                  Height="22"
                  RenderOptions.BitmapScalingMode="HighQuality"
                  Stretch="Uniform" />
              </CheckBox>
              <CheckBox
                x:Name="TargetOnlyFilter"
                Command="{Binding CategoryFilterCommand}"
                IsChecked="{Binding ShowTargetOnly}"
                Style="{StaticResource KindFilterStyle}"
                ToolTip="{loc:L Differencer_TargetOnly}">
                <Image
                  x:Name="TargetOnlyFilterIcon"
                  Width="22"
                  Height="22"
                  RenderOptions.BitmapScalingMode="HighQuality"
                  Stretch="Uniform" />
              </CheckBox>
              <CheckBox
                x:Name="ObjFilter"
                AutomationProperties.Name="Show OBJ"
                Command="{Binding BuildFolderFilterCommand}"
                IsChecked="{Binding ShowObj}"
                Style="{StaticResource KindFilterStyle}"
                ToolTip="{loc:L Differencer_ShowObj}">
                <Image
                  x:Name="ObjFilterIcon"
                  Width="22"
                  Height="22"
                  RenderOptions.BitmapScalingMode="HighQuality"
                  Stretch="Uniform" />
              </CheckBox>
              <CheckBox
                x:Name="BinFilter"
                AutomationProperties.Name="Show BIN"
                Command="{Binding BuildFolderFilterCommand}"
                IsChecked="{Binding ShowBin}"
                Style="{StaticResource KindFilterStyle}"
                ToolTip="{loc:L Differencer_ShowBin}">
                <Image
                  x:Name="BinFilterIcon"
                  Width="22"
                  Height="22"
                  RenderOptions.BitmapScalingMode="HighQuality"
                  Stretch="Uniform" />
              </CheckBox>
            </WrapPanel>
          </Border>
          <TreeView
            x:Name="FolderTree" Focusable="{Binding CanEdit}" IsHitTestVisible="{Binding CanEdit}" ItemsSource="{Binding FolderItems}"
            HorizontalContentAlignment="Stretch"
            Background="{DynamicResource CardBackground}"
            BorderThickness="0"
            Foreground="{DynamicResource Ink}"
            ItemContainerStyle="{StaticResource FolderItemStyle}"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectedItemChanged="FolderChanged"
            VirtualizingPanel.CacheLength="0"
            VirtualizingStackPanel.IsVirtualizing="True"
            VirtualizingStackPanel.VirtualizationMode="Recycling">
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding DisplayChildren}">
                <Grid ToolTip="{Binding Path}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <CheckBox
                    Margin="5"
                    VerticalAlignment="Center"
                    IsChecked="{Binding Checked, Mode=TwoWay}"
                    IsEnabled="{Binding CanSelect}"
                    IsThreeState="True" />
                  <Image
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="{Binding IconPreview}"
                    Stretch="Uniform">
                    <Image.Style>
                      <Style TargetType="Image">
                        <Setter Property="Width" Value="48" />
                        <Setter Property="Height" Value="48" />
                        <Setter Property="Margin" Value="5,3" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding TreeCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Width" Value="22" />
                            <Setter Property="Height" Value="22" />
                            <Setter Property="Margin" Value="3,1" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Image.Style>
                  </Image>
                  <TextBlock
                    Grid.Column="2"
                    Margin="0,5,5,5"
                    VerticalAlignment="Center"
                    Text="{Binding Label}"
                    TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="14" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding TreeCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="FontSize" Value="11" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>
      <GridSplitter
        Grid.Column="1"
        Width="5"
        HorizontalAlignment="Stretch"
        Background="{DynamicResource Line}" />
      <Border
        Grid.Column="2"
        Background="{DynamicResource CardBackground}"
        BorderBrush="{DynamicResource Line}"
        BorderThickness="1">
        <DockPanel>
          <Border
            Padding="10,7"
            Background="{DynamicResource HeaderBackground}"
            DockPanel.Dock="Top">
            <TextBlock
              x:Name="FilePanelTitle"
              Height="36"
              Padding="0,10,0,0"
              VerticalAlignment="Center"
              FontWeight="SemiBold"
              Text="{Binding FilePanelTitle}"
              TextTrimming="CharacterEllipsis" />
          </Border>
          <Grid>
            <ListView
              x:Name="FilesGrid" Focusable="{Binding CanEdit}" IsHitTestVisible="{Binding CanEdit}" ItemsSource="{Binding FileItems}"
              Background="{DynamicResource CardBackground}"
              BorderThickness="0"
              Foreground="{DynamicResource Ink}"
              ItemContainerStyle="{StaticResource FileListItemStyle}"
              MouseDoubleClick="OpenDiff"
              ScrollViewer.CanContentScroll="True"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              SelectionChanged="FileListSelectionChanged"
              SelectionMode="Single"
              VirtualizingPanel.CacheLength="0"
              VirtualizingPanel.ScrollUnit="Item"
              VirtualizingStackPanel.IsVirtualizing="True"
              VirtualizingStackPanel.VirtualizationMode="Recycling">
              <ListView.View>
                <GridView>
                  <GridViewColumn Width="44" Header="{loc:L Common_Sync}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsChecked="{Binding File.Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding File.CanSync}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="36" Header="">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <Image
                          Width="24"
                          Height="24"
                          RenderOptions.BitmapScalingMode="HighQuality"
                          Source="{Binding StatusIcon}"
                          Stretch="Uniform" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="36" Header="">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <Image
                          Width="24"
                          Height="24"
                          RenderOptions.BitmapScalingMode="HighQuality"
                          Source="{Binding Icon}"
                          Stretch="Uniform" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="200" Header="{loc:L Common_Name}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel VerticalAlignment="Center" ToolTip="{Binding File.RelativePath}">
                          <TextBlock Text="{Binding File.Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock
                            Margin="0,3,0,0"
                            FontSize="10"
                            Foreground="{DynamicResource Muted}"
                            Text="{Binding File.RelativePath}"
                            TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn
                    Width="60"
                    DisplayMemberBinding="{Binding Extension}"
                    Header="{loc:L Common_Type}" />
                  <GridViewColumn Width="110" Header="{loc:L Common_State}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock
                          VerticalAlignment="Center"
                          Text="{Binding File.State}"
                          TextWrapping="Wrap" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="210" Header="{loc:L Common_Source}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <ContentControl Content="{Binding Source}" ContentTemplate="{StaticResource SideTemplate}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="210" Header="{loc:L Common_Target}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <ContentControl Content="{Binding Target}" ContentTemplate="{StaticResource SideTemplate}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
            <Border
              x:Name="FilePanelBusy"
              Background="{DynamicResource OverlayScrim}"
              IsHitTestVisible="True"
              Visibility="{Binding IsFileBusy, Converter={StaticResource MvvmBooleanToVisibility}}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid
                  x:Name="FilePanelProgress"
                  Width="160"
                  Height="5">
                  <Border Background="{DynamicResource HeaderBackground}" CornerRadius="3" />
                  <Border
                    x:Name="FilePanelMarquee"
                    Width="48"
                    Height="5"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource Accent}"
                    CornerRadius="3">
                    <Border.RenderTransform>
                      <TranslateTransform x:Name="FilePanelMarqueeTransform" />
                    </Border.RenderTransform>
                  </Border>
                </Grid>
                <TextBlock
                  x:Name="FilePanelBusyText"
                  Margin="0,10,0,0"
                  HorizontalAlignment="Center"
                  Foreground="{DynamicResource Muted}"
                  Text="{Binding BusyMessage}" />
              </StackPanel>
            </Border>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
