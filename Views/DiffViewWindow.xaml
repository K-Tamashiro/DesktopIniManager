<Window
  x:Class="DesktopIniManager.Views.DiffViewWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:history="clr-namespace:DesktopIniManager.Views"
  xmlns:loc="clr-namespace:DesktopIniManager.Properties"
  Title="{Binding Title}"
  MinWidth="700"
  MinHeight="400"
  x:ClassModifier="internal"
  Background="{DynamicResource WindowBackground}"
  Foreground="{DynamicResource Ink}"
  WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <SolidColorBrush x:Key="SourceColor" Color="#E8B949" />
    <SolidColorBrush x:Key="TargetColor" Color="#2878BF" />
  </Window.Resources>
  <DockPanel Margin="16">
    <Grid Margin="0,0,0,10" DockPanel.Dock="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock
        VerticalAlignment="Center"
        FontSize="26"
        FontWeight="SemiBold"
        Foreground="{DynamicResource Accent}"
        Text="{loc:L Diff_Heading}" />
      <TextBlock
        x:Name="selectedFileText"
        Grid.Column="1"
        MaxWidth="720"
        Margin="20,0,12,4"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        FontSize="20"
        FontWeight="SemiBold"
        Foreground="{DynamicResource Ink}"
        Text="{Binding File.Name}"
        TextAlignment="Right"
        TextTrimming="CharacterEllipsis"
        ToolTip="{Binding File.RelativePath}" />
      <Button
        x:Name="CloseButton"
        Grid.Column="2"
        VerticalAlignment="Center"
        Background="Transparent"
        Command="{Binding CloseCommand}"
        Style="{DynamicResource IconButton}"
        ToolTip="{loc:L Common_Close}">
        <Image
          x:Name="CloseButtonIcon"
          RenderOptions.BitmapScalingMode="HighQuality"
          Stretch="Uniform" />
      </Button>
    </Grid>

    <Grid Margin="0,0,0,4" DockPanel.Dock="Top">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Grid Grid.ColumnSpan="3" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image
          x:Name="ExternalDiffLabelIcon"
          Width="28"
          Height="28"
          Margin="0,0,10,0"
          VerticalAlignment="Center"
          RenderOptions.BitmapScalingMode="HighQuality"
          Stretch="Uniform"
          ToolTip="External Diff" />
        <history:HistoryTextBox
          x:Name="externalDiffBox"
          Grid.Column="1"
          Height="36"
          Padding="8,4"
          HorizontalContentAlignment="Left"
          VerticalContentAlignment="Center"
          Background="{DynamicResource CardBackground}"
          BorderBrush="{DynamicResource Line}"
          Foreground="{DynamicResource Ink}"
          HistoryKey="DiffView-ExternalDiff"
          PreserveOrder="False"
          Text="{Binding ExternalDiff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          TextAlignment="Left"
          TextWrapping="NoWrap"
          ToolTip="External diff command. Use {source} and {target}." />
      </Grid>

      <Grid Grid.Row="1" Grid.ColumnSpan="3" Height="64">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <WrapPanel x:Name="actionsPanel" VerticalAlignment="Center" />
          <Viewbox x:Name="imageControlRow" Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly"
                   HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
            <StackPanel x:Name="imageToolbar" Orientation="Horizontal" />
          </Viewbox>
        </Grid>
        <Grid Grid.Column="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Center">
            <StackPanel x:Name="imageDetails" Orientation="Horizontal" />
          </Viewbox>
          <StackPanel x:Name="fileNavigationPanel" Grid.Column="1" HorizontalAlignment="Right"
                      VerticalAlignment="Center" Orientation="Horizontal" />
        </Grid>
      </Grid>
    </Grid>

    <TextBlock
      x:Name="status"
      Margin="8,6,8,0"
      DockPanel.Dock="Bottom"
      Foreground="{DynamicResource Muted}"
      Text="{Binding Status}"
      TextWrapping="Wrap" />

    <Grid DockPanel.Dock="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="34" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid Margin="8,0,8,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
          x:Name="sourceHeader"
          VerticalAlignment="Center"
          Foreground="{DynamicResource Ink}"
          Text="{Binding SourceHeader}"
          TextWrapping="Wrap" />
        <StackPanel
          x:Name="sourceStatusIcons"
          Grid.Column="1"
          Margin="8,0,0,0"
          VerticalAlignment="Center"
          Orientation="Horizontal" />
      </Grid>
      <Grid Grid.Column="2" Margin="8,0,8,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
          x:Name="targetHeader"
          VerticalAlignment="Center"
          Foreground="{DynamicResource Ink}"
          Text="{Binding TargetHeader}"
          TextWrapping="Wrap" />
        <StackPanel
          x:Name="targetStatusIcons"
          Grid.Column="1"
          Margin="8,0,0,0"
          VerticalAlignment="Center"
          Orientation="Horizontal" />
      </Grid>
    </Grid>

    <Grid x:Name="body" PreviewMouseWheel="Body_PreviewMouseWheel">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="mapColumn" Width="34" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
    </Grid>
  </DockPanel>
</Window>
