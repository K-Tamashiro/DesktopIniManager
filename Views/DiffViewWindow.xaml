<Window
  x:Class="DesktopIniManager.Views.DiffViewWindow"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:history="clr-namespace:DesktopIniManager.Views"
  xmlns:loc="clr-namespace:DesktopIniManager.Properties"
  Width="1280"
  Height="800"
  MinWidth="700"
  MinHeight="400"
  Background="{DynamicResource WindowBackground}"
  Foreground="{DynamicResource Ink}"
  WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <Grid Margin="0,0,0,10" DockPanel.Dock="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock
        VerticalAlignment="Center"
        FontSize="26"
        FontWeight="SemiBold"
        Foreground="{DynamicResource Accent}"
        Text="{loc:L Diff_Heading}" />
      <TextBlock
        x:Name="selectedFileText"
        Grid.Column="1"
        MaxWidth="720"
        Margin="20,0,12,4"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        FontSize="20"
        FontWeight="SemiBold"
        Foreground="{DynamicResource Ink}"
        TextAlignment="Right"
        TextTrimming="CharacterEllipsis" />
      <Button
        x:Name="CloseButton"
        Grid.Column="2"
        VerticalAlignment="Center"
        Click="Close_Click"
        Content="&#xE711;"
        FontFamily="Segoe MDL2 Assets"
        Style="{DynamicResource IconButton}"
        ToolTip="{loc:L Common_Close}" />
    </Grid>

    <Grid Margin="0,0,0,4" DockPanel.Dock="Top">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Grid Grid.ColumnSpan="3" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock
          Margin="0,0,10,0"
          VerticalAlignment="Center"
          Foreground="{DynamicResource Muted}"
          Text="External Diff" />
        <history:HistoryTextBox
          x:Name="externalDiffBox"
          Grid.Column="1"
          Height="36"
          Padding="8,4"
          VerticalContentAlignment="Center"
          HorizontalContentAlignment="Left"
          Background="{DynamicResource CardBackground}"
          BorderBrush="{DynamicResource Line}"
          Foreground="{DynamicResource Ink}"
          HistoryKey="DiffView-ExternalDiff"
          PreserveOrder="False"
          TextAlignment="Left"
          TextWrapping="NoWrap"
          ToolTip="External diff command. Use {source} and {target}." />
      </Grid>

      <WrapPanel x:Name="actionsPanel" Grid.Row="1" Grid.Column="0" />
      <StackPanel
        x:Name="imageToolbar"
        Grid.Row="1"
        Grid.Column="1"
        Margin="8,0,8,8"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Visibility="Collapsed" />
      <StackPanel
        x:Name="fileNavigationPanel"
        Grid.Row="1"
        Grid.Column="2"
        HorizontalAlignment="Right"
        Orientation="Horizontal" />
    </Grid>

    <TextBlock
      x:Name="status"
      Margin="8,6,8,0"
      DockPanel.Dock="Bottom"
      Foreground="{DynamicResource Muted}"
      Text="{Binding Status}"
      TextWrapping="Wrap" />

    <Grid DockPanel.Dock="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="34" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock
        x:Name="sourceHeader"
        Margin="8,4,8,8"
        Foreground="{DynamicResource Ink}"
        TextWrapping="Wrap" />
      <TextBlock
        x:Name="targetHeader"
        Grid.Column="2"
        Margin="8,4,8,8"
        Foreground="{DynamicResource Ink}"
        TextWrapping="Wrap" />
    </Grid>

    <Grid x:Name="body" PreviewMouseWheel="Body_PreviewMouseWheel">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="mapColumn" Width="34" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
    </Grid>
  </DockPanel>
</Window>
