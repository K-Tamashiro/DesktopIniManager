<Window x:Class="DesktopIniManager.Views.GrepWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Scoped Code Search" Icon="../DesktopIniManager.ico" Width="1120" Height="760" MinWidth="850" MinHeight="560" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Ink}" WindowStartupLocation="CenterOwner">
  <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Scoped Code Search" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/><TextBlock Text="Search only the projects selected in DesktopIniManager" Foreground="{DynamicResource Muted}" Margin="1,3,0,12"/></StackPanel><Button Grid.Column="1" Content="Close" Width="88" Height="36" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_Click" Background="{DynamicResource Secondary}"/></Grid>
    <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource CardBackground}" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ListBox x:Name="ScopeList" Height="86" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Ink}"/><StackPanel Grid.Column="1" Margin="12,0,0,0"><Button Content="Reload selection" Width="140" Click="ReloadScopes_Click"/><TextBlock x:Name="ScopeCountText" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,9,0,0"/></StackPanel></Grid></Border>
    <Grid Grid.Row="2" Margin="0,14,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Search text" Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/><TextBox x:Name="QueryBox"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Language profile" Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/><ComboBox x:Name="ProfileBox" Padding="8" SelectionChanged="ProfileBox_SelectionChanged"/></StackPanel><StackPanel Grid.Column="2" Margin="12,0,0,0"><TextBlock Text="Included extensions" Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/><TextBox x:Name="ExtensionsText" IsReadOnly="True"/></StackPanel><StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0"><Button x:Name="SearchButton" Content="Search" Width="92" Click="Search_Click"/><Button x:Name="CancelButton" Content="Cancel" Width="92" Margin="8,0,0,0" Background="{DynamicResource Secondary}" IsEnabled="False" Click="Cancel_Click"/></StackPanel></Grid>
    <DockPanel Grid.Row="3" Margin="0,0,0,10"><CheckBox x:Name="RegexBox" Content="Regular expression"/><CheckBox x:Name="MatchCaseBox" Content="Match case" Margin="18,0,0,0"/><CheckBox x:Name="WholeWordBox" Content="Whole word" Margin="18,0,0,0"/><ProgressBar x:Name="SearchProgress" DockPanel.Dock="Right" Width="260" Height="6" IsIndeterminate="True" Visibility="Collapsed" Foreground="{DynamicResource Accent}" Background="{DynamicResource HeaderBackground}"/></DockPanel>
    <Border Grid.Row="4" BorderBrush="{DynamicResource Line}" BorderThickness="1"><DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource Ink}" RowBackground="{DynamicResource CardBackground}" AlternatingRowBackground="{DynamicResource HeaderBackground}" BorderThickness="0" MouseDoubleClick="ResultsGrid_MouseDoubleClick"><DataGrid.Resources><Style x:Key="NumericCellStyle" TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="TextAlignment" Value="Right"/><Setter Property="Margin" Value="0,0,8,0"/></Style></DataGrid.Resources><DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource HeaderBackground}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Padding" Value="8,6"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGrid.ColumnHeaderStyle><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource CardBackground}"/><Style.Triggers><Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="{DynamicResource HeaderBackground}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeSelected}"/></Trigger></Style.Triggers></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTextColumn Header="Project" Binding="{Binding ScopeName}" Width="150"/><DataGridTextColumn Header="File" Binding="{Binding RelativePath}" Width="260"/><DataGridTextColumn Header="Line" Binding="{Binding LineNumber}" Width="65" ElementStyle="{StaticResource NumericCellStyle}"/><DataGridTextColumn Header="Column" Binding="{Binding ColumnNumber}" Width="70" ElementStyle="{StaticResource NumericCellStyle}"/><DataGridTextColumn Header="Match" Binding="{Binding LineText}" Width="*"/></DataGrid.Columns></DataGrid></Border>
    <Grid Grid.Row="5" Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Grid.RowSpan="2" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Text="Ready"/><TextBlock Grid.Column="1" Text="Editor" Margin="12,0,0,3" Foreground="{DynamicResource Muted}" FontSize="10"/><TextBlock Grid.Column="2" Text="Arguments ({file}, {line}, {column})" Margin="8,0,0,3" Foreground="{DynamicResource Muted}" FontSize="10"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="EditorBox" Margin="12,0,0,0" ToolTip="Editor executable or command"/><TextBox Grid.Row="1" Grid.Column="2" x:Name="EditorArgumentsBox" Margin="8,0,0,0"/><Button Grid.Row="1" Grid.Column="3" Content="Browse editor" Margin="8,0,0,0" VerticalAlignment="Stretch" Click="BrowseEditor_Click"/></Grid>
  </Grid>
</Window>
