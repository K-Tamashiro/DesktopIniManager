<Window
  x:Class="DesktopIniManager.Views.GrepWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:history="clr-namespace:DesktopIniManager.Views"
  xmlns:loc="clr-namespace:DesktopIniManager.Properties"
  Title="{loc:L Grep_Title}"
  Width="1280"
  Height="800"
  MinWidth="850"
  MinHeight="560"
  Background="{DynamicResource WindowBackground}"
  Foreground="{DynamicResource Ink}"
  Icon="../DesktopIniManager.ico"
  WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="MvvmBooleanToVisibility"/>
    <Style TargetType="{x:Type ComboBoxItem}">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Background" Value="{DynamicResource CardBackground}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBoxItem}">
            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource ThemeSelected}" />
        </Trigger>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Background" Value="{DynamicResource CardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBox}">
            <Grid>
              <ToggleButton
                x:Name="DropDownToggle"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                ClickMode="Press"
                Focusable="False"
                IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="3">
                      <Path
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Data="M 0 0 L 4 4 L 8 0"
                        Stroke="{DynamicResource Ink}"
                        StrokeThickness="1.5" />
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Border
                Margin="0,0,28,0"
                Padding="{TemplateBinding Padding}"
                IsHitTestVisible="False">
                <ContentPresenter
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                  Content="{TemplateBinding SelectionBoxItem}"
                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
              </Border>
              <Popup
                x:Name="PART_Popup"
                AllowsTransparency="True"
                Focusable="False"
                IsOpen="{TemplateBinding IsDropDownOpen}"
                Placement="Bottom"
                PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                <Border
                  MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                  MaxHeight="{TemplateBinding MaxDropDownHeight}"
                  Background="{DynamicResource CardBackground}"
                  BorderBrush="{DynamicResource Line}"
                  BorderThickness="1">
                  <ScrollViewer
                    CanContentScroll="True"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="DropDownToggle" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="DropDownToggle" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <ControlTemplate x:Key="GrepVerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
      <Border
        Margin="2,0"
        Background="{DynamicResource HeaderBackground}"
        CornerRadius="4">
        <Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton>
            <RepeatButton
              Command="{x:Static ScrollBar.PageUpCommand}"
              Focusable="False"
              Opacity="0" />
          </Track.DecreaseRepeatButton>
          <Track.Thumb>
            <Thumb>
              <Thumb.Template>
                <ControlTemplate TargetType="{x:Type Thumb}">
                  <Border
                    Margin="1"
                    Background="{DynamicResource Secondary}"
                    CornerRadius="4" />
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Track.Thumb>
          <Track.IncreaseRepeatButton>
            <RepeatButton
              Command="{x:Static ScrollBar.PageDownCommand}"
              Focusable="False"
              Opacity="0" />
          </Track.IncreaseRepeatButton>
        </Track>
      </Border>
    </ControlTemplate>
    <ControlTemplate x:Key="GrepHorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
      <Border
        Margin="0,2"
        Background="{DynamicResource HeaderBackground}"
        CornerRadius="4">
        <Track x:Name="PART_Track">
          <Track.DecreaseRepeatButton>
            <RepeatButton
              Command="{x:Static ScrollBar.PageLeftCommand}"
              Focusable="False"
              Opacity="0" />
          </Track.DecreaseRepeatButton>
          <Track.Thumb>
            <Thumb>
              <Thumb.Template>
                <ControlTemplate TargetType="{x:Type Thumb}">
                  <Border
                    Margin="1"
                    Background="{DynamicResource Secondary}"
                    CornerRadius="4" />
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Track.Thumb>
          <Track.IncreaseRepeatButton>
            <RepeatButton
              Command="{x:Static ScrollBar.PageRightCommand}"
              Focusable="False"
              Opacity="0" />
          </Track.IncreaseRepeatButton>
        </Track>
      </Border>
    </ControlTemplate>
    <Style TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Template" Value="{StaticResource GrepVerticalScrollBarTemplate}" />
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Vertical">
          <Setter Property="Width" Value="8" />
          <Setter Property="Height" Value="Auto" />
          <Setter Property="Template" Value="{StaticResource GrepVerticalScrollBarTemplate}" />
        </Trigger>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Height" Value="8" />
          <Setter Property="Width" Value="Auto" />
          <Setter Property="Template" Value="{StaticResource GrepHorizontalScrollBarTemplate}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid x:Name="TitleBar">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
          VerticalAlignment="Center"
          FontSize="27"
          FontWeight="SemiBold"
          Foreground="{DynamicResource Accent}"
          Text="{loc:L Grep_Title}" />
        <Button
          x:Name="CloseButton"
          Grid.Column="2"
          Margin="8,0,0,0"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Background="{DynamicResource Secondary}"
          Command="{Binding CloseCommand}"
          Content="&#xE8BB;"
          Style="{StaticResource IconButton}"
          ToolTip="{loc:L Common_Close}" />
      </Grid>
      <TextBlock
        Grid.Row="1"
        Margin="1,3,0,12"
        Foreground="{DynamicResource Muted}"
        Text="{loc:L Grep_ScopeHint}" />
    </Grid>
    <Border
      Grid.Row="1"
      Padding="12"
      Background="{DynamicResource CardBackground}"
      BorderBrush="{DynamicResource Line}"
      BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ListBox
          x:Name="ScopeList" ItemsSource="{Binding Scopes}"
          Height="86"
          Background="Transparent"
          BorderThickness="0"
          Foreground="{DynamicResource Ink}"
          HorizontalContentAlignment="Stretch"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="0,2" />
              <Setter Property="Focusable" Value="False" />
              <Setter Property="Background" Value="Transparent" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <CheckBox
                VerticalAlignment="Center"
                Content="{Binding FolderPath}"
                Foreground="{DynamicResource Ink}"
                IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Column="1" Margin="12,0,0,0">
          <Button
            Command="{Binding ReloadScopesCommand}"
            Style="{StaticResource IconTextButton}"
            ToolTip="{loc:L Grep_ReloadSelection}">
            <StackPanel Orientation="Horizontal">
              <TextBlock
                VerticalAlignment="Center"
                FontFamily="Segoe MDL2 Assets"
                FontSize="15"
                Text="&#xE72C;" />
              <TextBlock
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                Text="{loc:L Grep_Reload}" />
            </StackPanel>
          </Button>
          <TextBlock
            x:Name="ScopeCountText" Text="{Binding ScopeCountLabel}"
            Margin="0,9,0,0"
            HorizontalAlignment="Center"
            Foreground="{DynamicResource Muted}" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="2" Margin="0,14,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="180" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock
          Margin="0,0,0,5"
          Foreground="{DynamicResource Muted}"
          Text="{loc:L Grep_SearchText}" />
        <history:HistoryTextBox
          x:Name="QueryBox" Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          Height="36"
          Padding="8,4"
          VerticalContentAlignment="Center"
          HistoryKey="Grep-Query" />
      </StackPanel>
      <StackPanel
        Grid.Column="1"
        Margin="8,0,0,0"
        VerticalAlignment="Bottom"
        Orientation="Horizontal">
        <Button
          x:Name="ClearQueryButton"
          Height="36"
          MinWidth="36"
          Background="{DynamicResource Secondary}"
          Command="{Binding ClearQueryCommand}"
          Style="{StaticResource IconButton}"
          ToolTip="{loc:L Grep_ClearQuery}">
          <TextBlock
            FontFamily="Segoe MDL2 Assets"
            FontSize="12"
            Text="&#xE711;" />
        </Button>
        <Button
          x:Name="SearchButton"
          Height="36"
          Margin="8,0,0,0"
          Command="{Binding SearchCommand}"
          Style="{StaticResource IconTextButton}"
          ToolTip="{loc:L Common_Search}">
          <StackPanel Orientation="Horizontal">
            <TextBlock
              VerticalAlignment="Center"
              FontFamily="Segoe MDL2 Assets"
              FontSize="15"
              Text="&#xE721;" />
            <TextBlock
              Margin="6,0,0,0"
              VerticalAlignment="Center"
              Text="{loc:L Common_Search}" />
          </StackPanel>
        </Button>
        <Button
          x:Name="ClearResultsButton"
          Height="36"
          Margin="8,0,0,0"
          Background="{DynamicResource Secondary}"
          Command="{Binding ClearResultsCommand}"
          Style="{StaticResource IconTextButton}"
          ToolTip="{loc:L Grep_ClearResults}">
          <StackPanel Orientation="Horizontal">
            <TextBlock
              VerticalAlignment="Center"
              FontFamily="Segoe MDL2 Assets"
              FontSize="15"
              Text="&#xE74D;" />
            <TextBlock
              Margin="6,0,0,0"
              VerticalAlignment="Center"
              Text="{loc:L Common_Clear}" />
          </StackPanel>
        </Button>
        <Button
          x:Name="CancelButton"
          Height="36"
          Margin="8,0,0,0"
          Background="{DynamicResource Secondary}"
          Command="{Binding CancelCommand}"
          Style="{StaticResource IconTextButton}"
          ToolTip="{loc:L Common_Cancel}">
          <StackPanel Orientation="Horizontal">
            <TextBlock
              VerticalAlignment="Center"
              FontFamily="Segoe MDL2 Assets"
              FontSize="15"
              Text="&#xE711;" />
            <TextBlock
              Margin="6,0,0,0"
              VerticalAlignment="Center"
              Text="{loc:L Common_Cancel}" />
          </StackPanel>
        </Button>
      </StackPanel>
      <StackPanel Grid.Column="2" Margin="12,0,0,0">
        <TextBlock
          Margin="0,0,0,5"
          Foreground="{DynamicResource Muted}"
          Text="{loc:L Grep_LanguageProfile}" />
        <ComboBox
          x:Name="ProfileBox" IsEnabled="{Binding CanEdit}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
          Height="36"
          Padding="8,4"
          VerticalContentAlignment="Center"
          />
      </StackPanel>
      <StackPanel Grid.Column="3" Margin="12,0,0,0">
        <TextBlock
          Margin="0,0,0,5"
          Foreground="{DynamicResource Muted}"
          Text="{loc:L Grep_IncludedExtensions}" />
        <history:HistoryTextBox
          x:Name="ExtensionsText" Text="{Binding Extensions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          Height="36"
          Padding="8,4"
          VerticalContentAlignment="Center"
          HistoryKey="Grep-Extensions"
          IsEnabled="{Binding CanEdit}" />
      </StackPanel>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button
          Command="{Binding OpenResultsInEditorCommand}"
          Content="&#xE8A5;"
          Style="{StaticResource IconButton}"
          ToolTip="{loc:L Grep_OpenResults}" />
        <Button
          Margin="5,0,0,0"
          Background="{DynamicResource Secondary}"
          Command="{Binding SaveResultsCommand}"
          Content="&#xE74E;"
          Style="{StaticResource IconButton}"
          ToolTip="{loc:L Grep_SaveResults}" />
        <Button
          Margin="12,0,0,0"
          Command="{Binding ExpandResultGroupsCommand}"
          Content="&#xE70D;"
          Style="{StaticResource IconButton}"
          ToolTip="{loc:L Common_Expand}" />
        <Button
          Margin="5,0,0,0"
          Background="{DynamicResource Secondary}"
          Command="{Binding CollapseResultGroupsCommand}"
          Content="&#xE70E;"
          Style="{StaticResource IconButton}"
          ToolTip="{loc:L Common_Collapse}" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
        <CheckBox x:Name="RegexBox" IsChecked="{Binding UseRegex}" Content="{loc:L Grep_Regex}" />
        <CheckBox
          x:Name="MatchCaseBox" IsChecked="{Binding MatchCase}"
          Margin="18,0,0,0"
          Content="{loc:L Grep_MatchCase}" />
        <CheckBox
          x:Name="WholeWordBox" IsChecked="{Binding WholeWord}"
          Margin="18,0,0,0"
          Content="{loc:L Grep_WholeWord}" />
      </StackPanel>
      <DockPanel Margin="18,0,12,0" VerticalAlignment="Center">
        <Button
          x:Name="ClearListFilterButton"
          DockPanel.Dock="Right"
          Height="36"
          MinWidth="36"
          Margin="8,0,0,0"
          Background="{DynamicResource Secondary}"
          Command="{Binding ClearListFilterCommand}"
          Style="{StaticResource IconButton}"
          ToolTip="{loc:L Grep_ClearQuery}">
          <TextBlock
            FontFamily="Segoe MDL2 Assets"
            FontSize="12"
            Text="&#xE711;" />
        </Button>
        <history:HistoryTextBox
          x:Name="FilterBox"
          Height="36"
          Padding="8,2"
          VerticalAlignment="Center"
          VerticalContentAlignment="Center"
          CaretBrush="{DynamicResource Ink}"
          FontSize="13"
          HistoryKey="Grep-ListFilter"
          Text="{Binding ListFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          ToolTip="{loc:L Grep_ListFilter}" />
      </DockPanel>
    </DockPanel>
    <Border
      Grid.Row="4"
      BorderBrush="{DynamicResource Line}"
      BorderThickness="1">
      <DataGrid
        x:Name="ResultsGrid" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedMatch}"
        AutoGenerateColumns="False"
        Background="{DynamicResource CardBackground}"
        BorderThickness="0"
        CanUserResizeColumns="True"
        Foreground="{DynamicResource Ink}"
        GridLinesVisibility="None"
        HorizontalGridLinesBrush="Transparent"
        VerticalGridLinesBrush="Transparent"
        HeadersVisibility="Column"
        IsReadOnly="True"
        MinColumnWidth="56"
        EnableRowVirtualization="True"
        VirtualizingPanel.IsVirtualizing="True"
        VirtualizingPanel.IsVirtualizingWhenGrouping="True"
        VirtualizingPanel.VirtualizationMode="Standard"
        ScrollViewer.CanContentScroll="True"
        RowHeaderWidth="0"
        SelectionMode="Single"
        SelectionUnit="FullRow"
        RowHeight="28">
        <DataGrid.InputBindings>
          <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenMatchCommand}" />
        </DataGrid.InputBindings>
        <DataGrid.Resources>
          <Style x:Key="NumericCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,8,0" />
          </Style>
        </DataGrid.Resources>
        <DataGrid.GroupStyle>
          <GroupStyle>
            <GroupStyle.ContainerStyle>
              <Style TargetType="{x:Type GroupItem}">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                      <Expander
                        x:Name="ResultGroupExpander"
                        Collapsed="ResultGroupExpander_Collapsed"
                        DataContextChanged="ResultGroupExpander_DataContextChanged"
                        Expanded="ResultGroupExpander_Expanded"
                        IsExpanded="True"
                        Loaded="ResultGroupExpander_Loaded">
                        <Expander.Template>
                          <ControlTemplate TargetType="{x:Type Expander}">
                            <DockPanel LastChildFill="True">
                              <Border
                                DockPanel.Dock="Top"
                                Margin="0,1,0,1"
                                Background="#2F4F4F"
                                BorderThickness="0"
                                MouseLeftButtonDown="GroupHeader_Click">
                                <Border.ContextMenu>
                                  <ContextMenu>
                                    <MenuItem Click="CopyGroupPath_Click" Header="{loc:L Grep_CopyPath}" />
                                    <MenuItem Click="OpenGroupFolder_Click" Header="{loc:L Grep_OpenFolder}" />
                                  </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <Button
                                    Width="28"
                                    Height="28"
                                    Margin="4,2,2,2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="RemoveGroup_Click"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="{loc:L Grep_RemoveGroup}">
                                    <TextBlock
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                      Foreground="{DynamicResource Ink}"
                                      Text="&#xE711;" />
                                  </Button>
                                  <TextBlock
                                    Grid.Column="1"
                                    Margin="4,4,10,4"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource Ink}"
                                    TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                    <Run Foreground="{DynamicResource Muted}" Text=" -" />
                                    <Run Foreground="{DynamicResource Muted}" Text="{Binding ItemCount, Mode=OneWay}" />
                                  </TextBlock>
                                </Grid>
                              </Border>
                              <ContentPresenter x:Name="ExpandSite" ContentSource="Content" />
                            </DockPanel>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Collapsed" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Expander.Template>
                        <ItemsPresenter />
                      </Expander>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </GroupStyle.ContainerStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </DataGrid.GroupStyle>
        <DataGrid.ColumnHeaderStyle>
          <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource HeaderBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </Style>
        </DataGrid.ColumnHeaderStyle>
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeSelected}" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.CellStyle>
          <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                <Setter Property="BorderThickness" Value="0" />
              </Trigger>
              <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </DataGrid.CellStyle>
        <DataGrid.Columns>
          <DataGridTextColumn
            Width="200"
            MinWidth="90"
            Binding="{Binding ScopeName}"
            Header="{loc:L Grep_Project}" />
          <DataGridTextColumn
            Width="300"
            MinWidth="160"
            Binding="{Binding FileName}"
            Header="{loc:L Grep_FileName}" />
          <DataGridTextColumn
            Width="80"
            MinWidth="60"
            Binding="{Binding LineNumber}"
            ElementStyle="{StaticResource NumericCellStyle}"
            Header="{loc:L Grep_Line}" />
          <DataGridTextColumn
            Width="80"
            MinWidth="60"
            Binding="{Binding ColumnNumber}"
            ElementStyle="{StaticResource NumericCellStyle}"
            Header="{loc:L Grep_Column}" />
          <DataGridTemplateColumn
            Width="550"
            MinWidth="200"
            Header="{loc:L Grep_Match}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock
                  VerticalAlignment="Center"
                  TextTrimming="CharacterEllipsis"
                  DataContextChanged="MatchLine_DataContextChanged"
                  Loaded="MatchLine_Loaded" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
    <StackPanel Grid.Row="5" Margin="0,10,0,0">
      <ProgressBar
        x:Name="SearchProgress"
        Height="6"
        Margin="0,0,0,6"
        Background="{DynamicResource HeaderBackground}"
        Foreground="{DynamicResource Accent}"
        IsIndeterminate="True"
        Visibility="{Binding IsSearching, Converter={StaticResource MvvmBooleanToVisibility}}" />
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" MinWidth="160" />
          <ColumnDefinition Width="1.2*" />
          <ColumnDefinition Width="1.2*" />
          <ColumnDefinition Width="1*" MaxWidth="320" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
          x:Name="StatusText"
          Grid.RowSpan="2"
          MaxWidth="280"
          Margin="0,0,12,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Foreground="{DynamicResource Muted}"
          Text="{Binding Status}"
          TextWrapping="Wrap" />
        <TextBlock
          Grid.Column="2"
          Margin="0,0,0,3"
          FontSize="10"
          Foreground="{DynamicResource Muted}"
          Text="{loc:L Grep_Editor}" />
        <TextBlock
          Grid.Column="3"
          Margin="8,0,0,3"
          FontSize="10"
          Foreground="{DynamicResource Muted}"
          Text="{loc:L Grep_EditorArguments}" />
        <history:HistoryTextBox
          x:Name="EditorBox" Text="{Binding EditorPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          Grid.Row="1"
          Grid.Column="2"
          HorizontalContentAlignment="Left"
          HistoryKey="Grep-Editor"
          PreserveOrder="True"
          TextAlignment="Left"
          TextWrapping="NoWrap"
          ToolTip="{loc:L Grep_EditorExecutable}" />
        <history:HistoryTextBox
          x:Name="EditorArgumentsBox" Text="{Binding EditorArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          Grid.Row="1"
          Grid.Column="3"
          Margin="8,0,0,0"
          HorizontalContentAlignment="Left"
          HistoryKey="Grep-EditorArguments"
          PreserveOrder="True"
          TextAlignment="Left"
          TextWrapping="NoWrap" />
        <Button
          Grid.Row="1"
          Grid.Column="4"
          Height="36"
          Margin="8,0,0,0"
          VerticalAlignment="Stretch"
          Command="{Binding BrowseEditorCommand}"
          Content="&#xE8B7;"
          Style="{StaticResource IconButton}"
          ToolTip="{loc:L Grep_BrowseEditor}" />
      </Grid>
    </StackPanel>
  </Grid>
</Window>
