<Window x:Class="DesktopIniManager.Views.IconGroupBrowserWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Icon" Width="900" Height="650" MinWidth="620" MinHeight="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Ink}">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="2,0,2,14"><StackPanel><TextBlock Text="Choose Icon" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/><TextBlock x:Name="FilePathText" Margin="0,4,120,0" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock x:Name="CountText" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{DynamicResource Muted}"/></Grid>
    <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource CardBackground}" BorderThickness="1" Padding="8">
      <ListBox x:Name="GroupList" BorderThickness="0" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource Ink}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" SelectionMode="Single" MouseDoubleClick="GroupList_MouseDoubleClick">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel IsItemsHost="True"/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Width" Value="130"/><Setter Property="Height" Value="160"/><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="6"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeSelected}"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><Grid><Grid.RowDefinitions><RowDefinition Height="105"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="1"><Image Source="{Binding Preview}" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality"/></Border><TextBlock Grid.Row="1" Text="{Binding DisplayName}" Foreground="{DynamicResource Ink}" Margin="1,6,1,0" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="2" Text="{Binding ImageCountText}" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource Muted}"/></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <Grid Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="Double-click an icon to select it" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Width="110" Margin="0,0,8,0" IsCancel="True" Background="{DynamicResource Secondary}"/><Button Content="Select" Width="110" IsDefault="True" Click="Select_Click"/></StackPanel></Grid>
  </Grid>
</Window>
