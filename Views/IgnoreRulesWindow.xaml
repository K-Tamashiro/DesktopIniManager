<Window x:Class="DesktopIniManager.Views.IgnoreRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopIniManager.Properties"
        x:ClassModifier="internal"
        Title="{loc:L Ignore_Title}" Width="580" Height="480" MinWidth="440" MinHeight="320"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Ink}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{loc:L Ignore_Description}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <ListBox Grid.Row="1" ItemsSource="{Binding Rules}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4,6" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding Exclude, Mode=TwoWay}" VerticalContentAlignment="Center"
                              Foreground="{DynamicResource Ink}" ToolTip="{Binding Location}">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="{Binding Pattern}" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Location}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Text="{loc:L Ignore_Help}" TextWrapping="Wrap" Margin="0,12,0,12" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource IconButton}" IsCancel="True" ToolTip="{loc:L Ignore_Cancel}"
                    AutomationProperties.Name="{loc:L Ignore_Cancel}" Margin="0,0,8,0">
                <Image x:Name="CancelIcon" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </Button>
            <Button Style="{StaticResource IconButton}" Click="Invert_Click" ToolTip="{loc:L Ignore_Invert}"
                    AutomationProperties.Name="{loc:L Ignore_Invert}" Margin="0,0,8,0">
                <Image x:Name="InvertIcon" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </Button>
            <Button Style="{StaticResource IconButton}" Click="Apply_Click" IsDefault="True" ToolTip="{loc:L Ignore_Apply}"
                    AutomationProperties.Name="{loc:L Ignore_Apply}">
                <Image x:Name="ApplyIcon" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
