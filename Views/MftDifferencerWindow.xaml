<Window x:Class="DesktopIniManager.Views.MftDifferencerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:history="clr-namespace:DesktopIniManager.Views" xmlns:res="clr-namespace:DesktopIniManager.Properties"
 Title="{x:Static res:Strings.Mft_Title}" Width="1280" Height="800" MinWidth="960" MinHeight="540" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Ink}">
 <Window.Resources>
  <SolidColorBrush x:Key="SourceColor" Color="#E8B949"/>
  <SolidColorBrush x:Key="TargetColor" Color="#2878BF"/>
  <SolidColorBrush x:Key="CleanColor" Color="#28784B"/>
  <Style x:Key="MftActionButton" TargetType="Button" BasedOn="{StaticResource IconTextButton}">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid x:Name="Frame">
     <Border Background="{TemplateBinding Background}" CornerRadius="10"/>
     <Border x:Name="Highlight" Background="White" Opacity="0" CornerRadius="10"/>
     <Border Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Highlight" Property="Opacity" Value="0.12"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Highlight" Property="Opacity" Value="0.22"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.48"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="KindFilterStyle" TargetType="CheckBox">
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Margin" Value="0,0,6,0"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="CheckBox">
      <Border x:Name="Frame" Background="{DynamicResource Secondary}" CornerRadius="8" Padding="5,4" SnapsToDevicePixels="True">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Frame" Property="Background" Value="{DynamicResource AccentSoft}"/>
        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter TargetName="Frame" Property="BorderThickness" Value="1"/>
       </Trigger>
       <Trigger Property="IsChecked" Value="False">
        <Setter Property="Opacity" Value="0.55"/>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Opacity" Value="1"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.35"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="FileListItemStyle" TargetType="ListViewItem">
   <Setter Property="Height" Value="80"/>
   <EventSetter Event="Loaded" Handler="FileRowLoaded"/><EventSetter Event="Unloaded" Handler="FileRowUnloaded"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="RowBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2,0,0,0" Padding="2,1" TextElement.Foreground="{TemplateBinding Foreground}"><GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource ThemeSelected}"/><Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="GridViewColumnHeader">
   <Setter Property="Background" Value="{DynamicResource HeaderBackground}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="Padding" Value="8,5"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewColumnHeader"><Border x:Name="HeaderBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FolderItemStyle" TargetType="TreeViewItem">
   <Setter Property="IsExpanded" Value="{Binding Expanded, Mode=TwoWay}"/><Setter Property="IsSelected" Value="{Binding Active, Mode=TwoWay}"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
    <Grid Background="Transparent"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <ToggleButton x:Name="Expander" Content="▶" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Foreground="{DynamicResource Muted}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/></ControlTemplate></ToggleButton.Template></ToggleButton>
     <Border Grid.Column="1" Background="{TemplateBinding Background}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch"/></Border>
     <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Expander" Property="Content" Value="▼"/></Trigger><Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeSelected}"/></Trigger></Style.Triggers>
  </Style>
  <DataTemplate x:Key="SideTemplate">
   <DockPanel Margin="6" VerticalAlignment="Center" ToolTip="{Binding Info}" LastChildFill="True"><Image DockPanel.Dock="Left" Source="{Binding Thumbnail}" Width="56" Height="48" Margin="0,0,6,0" Stretch="Uniform" HorizontalAlignment="Left"><Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding HasImage}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding SummaryInfo}" FontSize="11"/><TextBlock Text="{Binding Dimensions}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel></DockPanel>
  </DataTemplate>
 </Window.Resources>
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top">
   <Grid Margin="0,0,0,10">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <TextBlock Text="{x:Static res:Strings.Mft_Title}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
    <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CloseClick" ToolTip="{x:Static res:Strings.Common_Close}"/>
   </Grid>
   <Grid x:Name="RootControls"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock Text="{x:Static res:Strings.Common_Source}" VerticalAlignment="Center" Margin="0,0,12,6"/><history:HistoryTextBox HistoryKey="Mft-Source" x:Name="SourceBox" Grid.Column="1" Margin="0,0,8,6" BorderBrush="{StaticResource SourceColor}" BorderThickness="4,1,1,1"/>
    <Button Content="&#xE8B7;" Style="{StaticResource IconButton}" Grid.Column="2" Click="BrowseSource" ToolTip="{x:Static res:Strings.Common_Browse}" Margin="0,0,0,6"/>
    <TextBlock Text="{x:Static res:Strings.Common_Target}" Grid.Row="1" VerticalAlignment="Center"/><history:HistoryTextBox HistoryKey="Mft-Target" x:Name="TargetBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,0" BorderBrush="{StaticResource TargetColor}" BorderThickness="4,1,1,1"/>
    <Button Content="&#xE8B7;" Style="{StaticResource IconButton}" Grid.Row="1" Grid.Column="2" Click="BrowseTarget" ToolTip="{x:Static res:Strings.Common_Browse}"/>
   </Grid>
   <Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal"><Button x:Name="CompareButton" Style="{StaticResource MftActionButton}" Click="CompareClick"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="{x:Static res:Strings.Common_Compare}" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
    <Button x:Name="CancelCompareButton" Content="&#xE711;" Style="{StaticResource IconButton}" Click="CancelCompareClick" Margin="8,0,0,0" Background="{DynamicResource Secondary}" ToolTip="{x:Static res:Strings.Mft_CancelCompare}" IsEnabled="False"/>
    <CheckBox x:Name="CompareTimestampBox" Content="{x:Static res:Strings.Mft_CompareDates}" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="{x:Static res:Strings.Mft_CompareDatesTip}"/>
    <Button x:Name="CleanSolutionButton" Style="{StaticResource MftActionButton}" Background="{StaticResource CleanColor}" Click="CleanSolutionClick" Margin="12,0,0,0" ToolTip="{x:Static res:Strings.Mft_CleanTip}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE75C;" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="{x:Static res:Strings.Mft_CleanSolution}" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
    </StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
    <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="16,0,0,0"/>
    <Button x:Name="ForwardButton" Style="{StaticResource MftActionButton}" Background="{StaticResource SourceColor}" Foreground="#20252B" Click="ForwardClick" Margin="12,0,0,0" IsEnabled="False"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74B;" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="{x:Static res:Strings.Mft_SourceToTarget}" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
    <Button x:Name="ReverseButton" Style="{StaticResource MftActionButton}" Background="{StaticResource TargetColor}" Click="ReverseClick" Margin="8,0,0,0" IsEnabled="False"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74A;" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="{x:Static res:Strings.Mft_TargetToSource}" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
    </StackPanel>
   </Grid>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
   <ProgressBar x:Name="CompareProgress" Height="6" Visibility="Collapsed" Margin="0,0,0,6" Foreground="{DynamicResource Accent}" Background="{DynamicResource HeaderBackground}"/>
   <TextBlock x:Name="StatusText" Text="{x:Static res:Strings.Mft_NeedRoots}" TextWrapping="Wrap"/>
  </StackPanel>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300" MinWidth="220"/><ColumnDefinition Width="5"/><ColumnDefinition MinWidth="400"/></Grid.ColumnDefinitions>
   <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource CardBackground}"><DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBackground}" Padding="10,7"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button Style="{StaticResource IconButton}" Content="&#xE70D;" Click="ExpandAll_Click" ToolTip="{x:Static res:Strings.Common_Expand}"/><Button Style="{StaticResource IconButton}" Content="&#xE70E;" Margin="5,0,0,0" Background="{DynamicResource Secondary}" Click="CollapseAll_Click" ToolTip="{x:Static res:Strings.Common_Collapse}"/>
     <Button Style="{StaticResource TypeSizeButton}" Content="a" FontSize="13" Margin="10,0,0,0" Background="{DynamicResource Secondary}" Click="CompactTree_Click" ToolTip="{x:Static res:Strings.Main_TreeCompact}"/><Button Style="{StaticResource TypeSizeButton}" Content="A" FontSize="17" Margin="5,0,0,0" Background="{DynamicResource Secondary}" Click="ComfortableTree_Click" ToolTip="{x:Static res:Strings.Main_TreeComfortable}"/>
    </StackPanel><TextBlock Text="{x:Static res:Strings.Common_Folders}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel></Border>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="8,5"><WrapPanel x:Name="CategoryFilters" IsEnabled="False">
     <CheckBox x:Name="SameFilter" Style="{StaticResource KindFilterStyle}" IsChecked="False" Click="KindFilter_Click" ToolTip="{x:Static res:Strings.Mft_SameTimeSize}">
      <Image x:Name="SameFilterIcon" Width="22" Height="22" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
     </CheckBox>
     <CheckBox x:Name="DifferentFilter" Style="{StaticResource KindFilterStyle}" IsChecked="True" Click="KindFilter_Click" ToolTip="{x:Static res:Strings.Mft_DifferentMeta}">
      <Image x:Name="DifferentFilterIcon" Width="22" Height="22" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
     </CheckBox>
     <CheckBox x:Name="SourceOnlyFilter" Style="{StaticResource KindFilterStyle}" IsChecked="True" Click="KindFilter_Click" ToolTip="{x:Static res:Strings.Mft_SourceOnly}">
      <Image x:Name="SourceOnlyFilterIcon" Width="22" Height="22" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
     </CheckBox>
     <CheckBox x:Name="TargetOnlyFilter" Style="{StaticResource KindFilterStyle}" IsChecked="True" Click="KindFilter_Click" ToolTip="{x:Static res:Strings.Mft_TargetOnly}">
      <Image x:Name="TargetOnlyFilterIcon" Width="22" Height="22" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
     </CheckBox>
     <CheckBox x:Name="ObjFilter" Style="{StaticResource KindFilterStyle}" IsChecked="False" Click="BuildFolderFilter_Click" ToolTip="{x:Static res:Strings.Mft_ShowObj}" AutomationProperties.Name="Show OBJ">
      <Image x:Name="ObjFilterIcon" Width="22" Height="22" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
     </CheckBox>
     <CheckBox x:Name="BinFilter" Style="{StaticResource KindFilterStyle}" IsChecked="False" Click="BuildFolderFilter_Click" ToolTip="{x:Static res:Strings.Mft_ShowBin}" AutomationProperties.Name="Show BIN">
      <Image x:Name="BinFilterIcon" Width="22" Height="22" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
     </CheckBox>
    </WrapPanel></Border>
    <TreeView x:Name="FolderTree" SelectedItemChanged="FolderChanged" ItemContainerStyle="{StaticResource FolderItemStyle}" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.CacheLength="0" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource Ink}">
     <TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding DisplayChildren}"><Grid ToolTip="{Binding Path}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <CheckBox IsThreeState="True" IsChecked="{Binding Checked, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" Margin="5" VerticalAlignment="Center"/>
      <Image Grid.Column="1" Source="{Binding IconPreview}" Stretch="Uniform" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"><Image.Style><Style TargetType="Image"><Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/><Setter Property="Margin" Value="5,3"/><Style.Triggers><DataTrigger Binding="{Binding TreeCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="Margin" Value="3,1"/></DataTrigger></Style.Triggers></Style></Image.Style></Image>
      <TextBlock Grid.Column="2" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,5,5,5"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Style.Triggers><DataTrigger Binding="{Binding TreeCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="FontSize" Value="11"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid></HierarchicalDataTemplate></TreeView.ItemTemplate>
    </TreeView>
   </DockPanel></Border>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Line}"/>
   <Border Grid.Column="2" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource CardBackground}"><DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBackground}" Padding="10,7"><TextBlock x:Name="FilePanelTitle" Text="{x:Static res:Strings.Common_Files}" Height="36" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Padding="0,10,0,0"/></Border>
    <Grid>
    <ListView x:Name="FilesGrid" ItemContainerStyle="{StaticResource FileListItemStyle}" BorderThickness="0" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource Ink}" SelectionMode="Single" ScrollViewer.CanContentScroll="True" VirtualizingPanel.CacheLength="0" VirtualizingPanel.ScrollUnit="Item" ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" SelectionChanged="FileListSelectionChanged" MouseDoubleClick="OpenDiff"><ListView.View><GridView>
     <GridViewColumn Header="{x:Static res:Strings.Common_Sync}" Width="44"><GridViewColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding File.Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding File.CanSync}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
     <GridViewColumn Header="" Width="36"><GridViewColumn.CellTemplate><DataTemplate><Image Source="{Binding StatusIcon}" Width="24" Height="24" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
     <GridViewColumn Header="" Width="36"><GridViewColumn.CellTemplate><DataTemplate><Image Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
     <GridViewColumn Header="{x:Static res:Strings.Common_Name}" Width="200"><GridViewColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center" ToolTip="{Binding File.RelativePath}"><TextBlock Text="{Binding File.Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding File.RelativePath}" FontSize="10" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
     <GridViewColumn Header="{x:Static res:Strings.Common_Type}" Width="60" DisplayMemberBinding="{Binding Extension}"/>
     <GridViewColumn Header="{x:Static res:Strings.Common_State}" Width="110"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding File.State}" TextWrapping="Wrap" VerticalAlignment="Center"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
     <GridViewColumn Header="{x:Static res:Strings.Common_Source}" Width="210"><GridViewColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Source}" ContentTemplate="{StaticResource SideTemplate}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
     <GridViewColumn Header="{x:Static res:Strings.Common_Target}" Width="210"><GridViewColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Target}" ContentTemplate="{StaticResource SideTemplate}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
    </GridView></ListView.View></ListView>
    <Border x:Name="FilePanelBusy" Visibility="Collapsed" Background="#CC111821" IsHitTestVisible="True">
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
      <ProgressBar x:Name="FilePanelProgress" Width="160" Height="5" IsIndeterminate="True" Foreground="{DynamicResource Accent}" Background="{DynamicResource HeaderBackground}"/>
      <TextBlock x:Name="FilePanelBusyText" Text="{x:Static res:Strings.Common_PleaseWait}" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}"/>
     </StackPanel>
    </Border>
    </Grid>
   </DockPanel></Border>
  </Grid>
 </DockPanel>
</Window>
