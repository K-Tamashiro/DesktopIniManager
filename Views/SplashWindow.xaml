<Window
  x:Class="DesktopIniManager.Views.SplashWindow"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:loc="clr-namespace:DesktopIniManager.Properties"
  Title="{loc:L Splash_Title}"
  WindowStartupLocation="CenterScreen"
  WindowStyle="None"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  Background="#030F1C">
  <Viewbox Stretch="Uniform">
    <Canvas Width="1774" Height="887">
      <Image
        Width="1774"
        Height="887"
        Stretch="Fill"
        Source="/DesktopIniManager;component/Assets/splash-background.png" />
      <TextBlock
        Canvas.Left="377"
        Canvas.Top="484"
        Width="820"
        FontFamily="Segoe UI"
        FontSize="36"
        Foreground="#339AFF"
        Text="{loc:L Splash_Initializing}"
        TextTrimming="CharacterEllipsis" />
      <TextBlock
        x:Name="stage"
        Canvas.Left="377"
        Canvas.Top="548"
        Width="850"
        FontFamily="Segoe UI"
        FontSize="28"
        Foreground="#ECF2FA"
        Text="{loc:L Splash_LoadingSettings}"
        TextTrimming="CharacterEllipsis" />
      <TextBlock
        x:Name="previous"
        Canvas.Left="377"
        Canvas.Top="603"
        Width="850"
        FontFamily="Segoe UI"
        FontSize="22"
        Foreground="#9CAFC5"
        TextTrimming="CharacterEllipsis" />
      <ProgressBar
        x:Name="progress"
        Canvas.Left="377"
        Canvas.Top="676"
        Width="700"
        Height="6"
        Minimum="0"
        Maximum="4"
        Background="#192C41"
        Foreground="#2594FF" />
      <TextBlock
        x:Name="copyright"
        Canvas.Left="1090"
        Canvas.Top="786"
        Width="630"
        FontFamily="Segoe UI"
        FontSize="25"
        Foreground="#BCCADA"
        TextAlignment="Right"
        TextTrimming="CharacterEllipsis" />
      <TextBlock
        Canvas.Left="1090"
        Canvas.Top="824"
        Width="630"
        FontFamily="Segoe UI"
        FontSize="22"
        Foreground="#8EA7C2"
        Text="{loc:L Splash_Author}"
        TextAlignment="Right"
        TextTrimming="CharacterEllipsis" />
    </Canvas>
  </Viewbox>
</Window>
