<Window
  x:Class="DesktopIniManager.Views.SynchronizeConfirmWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Synchronize files"
  Width="620"
  x:ClassModifier="internal"
  Background="{DynamicResource WindowBackground}"
  Foreground="{DynamicResource Ink}"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  SizeToContent="Height"
  WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <SolidColorBrush x:Key="SourceColor" Color="#E8B949" />
    <SolidColorBrush x:Key="TargetColor" Color="#2878BF" />
    <Style
      x:Key="DifferencerActionButton"
      BasedOn="{StaticResource IconTextButton}"
      TargetType="Button">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Frame">
              <Border Background="{TemplateBinding Background}" CornerRadius="10" />
              <Border
                x:Name="Highlight"
                Background="White"
                CornerRadius="10"
                Opacity="0" />
              <Border Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Highlight" Property="Opacity" Value="0.12" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Highlight" Property="Opacity" Value="0.22" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Frame" Property="Opacity" Value="0.48" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid>
      <TextBlock
        x:Name="HeadingText"
        Margin="0,0,120,0"
        FontSize="24"
        FontWeight="SemiBold"
        Foreground="{DynamicResource Accent}" />
      <StackPanel
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Orientation="Horizontal">
        <Image
          x:Name="DirectionLeftIcon"
          Width="48"
          Height="48"
          Margin="0,0,8,0"
          RenderOptions.BitmapScalingMode="HighQuality"
          Stretch="Uniform" />
        <Image
          x:Name="DirectionRightIcon"
          Width="48"
          Height="48"
          RenderOptions.BitmapScalingMode="HighQuality"
          Stretch="Uniform" />
      </StackPanel>
    </Grid>
    <TextBlock
      x:Name="SummaryText"
      Grid.Row="1"
      Margin="0,5,0,18"
      FontSize="13"
      Foreground="{DynamicResource Muted}" />
    <Border
      Grid.Row="2"
      Padding="16,13"
      Background="{DynamicResource CardBackground}"
      BorderBrush="{DynamicResource Line}"
      BorderThickness="1"
      CornerRadius="6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock
          x:Name="SourceLabelText"
          Margin="0,0,12,8"
          FontWeight="SemiBold"
          Foreground="{DynamicResource Muted}" />
        <TextBlock
          x:Name="SourcePathText"
          Grid.Column="1"
          Margin="0,0,0,8"
          TextTrimming="CharacterEllipsis" />
        <TextBlock
          x:Name="TargetLabelText"
          Grid.Row="1"
          Margin="0,0,12,0"
          FontWeight="SemiBold"
          Foreground="{DynamicResource Muted}" />
        <TextBlock
          x:Name="TargetPathText"
          Grid.Row="1"
          Grid.Column="1"
          TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>
    <ItemsControl
      x:Name="OperationsList"
      Grid.Row="3"
      Margin="0,16">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border
            Margin="0,0,8,0"
            Padding="10,6"
            Background="{DynamicResource AccentSoft}"
            BorderBrush="{DynamicResource Line}"
            BorderThickness="1"
            CornerRadius="5">
            <TextBlock FontWeight="SemiBold" Text="{Binding}" />
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock
        VerticalAlignment="Center"
        FontSize="12"
        Foreground="{DynamicResource Muted}"
        x:Name="WarningText" />
      <Button
        x:Name="CancelButton"
        Grid.Column="1"
        Width="36"
        Height="36"
        MinWidth="36"
        Margin="12,0,0,0"
        Background="Transparent"
        Click="Cancel_Click"
        IsCancel="True"
        Style="{StaticResource IconButton}"
        ToolTip="Cancel" />
      <Button
        x:Name="SyncButton"
        Grid.Column="2"
        Height="34"
        MinWidth="118"
        Margin="8,0,0,0"
        Click="Sync_Click"
        IsDefault="True"
        Style="{DynamicResource DifferencerActionButton}" />
    </Grid>
  </Grid>
</Window>
